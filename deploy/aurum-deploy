#!/usr/bin/env bash
# /usr/local/bin/aurum-deploy [--force] — выкатка aurum-msk.ru.
# Забирает main из GitHub, при смене package-lock.json ставит зависимости,
# собирает, перезапускает сервис и проверяет ответ. Если сборка упала,
# сервис не трогаем — работающий сайт остаётся как был.
set -euo pipefail

DIR=/srv/aurum
APP_USER=aurum
SERVICE=aurum
PORT=3002
ENV_FILE=/etc/aurum/aurum.env

as_app() { runuser -u "$APP_USER" -- "$@"; }

cd "$DIR"
as_app git fetch --quiet origin main
OLD=$(as_app git rev-parse HEAD)
NEW=$(as_app git rev-parse origin/main)

if [ "$OLD" = "$NEW" ] && [ "${1:-}" != "--force" ]; then
  echo "Уже актуально: ${NEW:0:7}"
  exit 0
fi

LOCK_CHANGED=$(as_app git diff --name-only "$OLD" "$NEW" -- package-lock.json)
as_app git reset --hard --quiet "$NEW"

if [ -n "$LOCK_CHANGED" ] || [ ! -d node_modules ]; then
  as_app npm ci --no-audit --no-fund
fi

# Адрес сайта и запрет индексации запекаются в страницы при сборке.
# Секреты каналов заявок сборке не нужны — передаём только эти две переменные.
SITE_URL=$(grep -E '^SITE_URL=' "$ENV_FILE" | cut -d= -f2-)
ALLOW_INDEXING=$(grep -E '^ALLOW_INDEXING=' "$ENV_FILE" | cut -d= -f2-)
as_app env SITE_URL="$SITE_URL" ALLOW_INDEXING="$ALLOW_INDEXING" npm run build

systemctl restart "$SERVICE"
for _ in $(seq 1 30); do
  if curl -fsS -o /dev/null "http://127.0.0.1:$PORT/"; then
    echo "Выкачено: ${NEW:0:7}"
    exit 0
  fi
  sleep 1
done

echo "Сервис не ответил за 30 секунд" >&2
journalctl -u "$SERVICE" -n 30 --no-pager >&2
exit 1
