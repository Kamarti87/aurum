# /etc/aurum/aurum.env — root:root, права 600
SITE_URL=https://aurum-msk.ru
# true — открыть поисковикам (вместе с заголовком в Caddy), затем aurum-deploy --force
ALLOW_INDEXING=false

# заявки: каналы включаются, когда заданы их переменные
# MAX_BOT_TOKEN=
# MAX_CHAT_ID=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_TO=
